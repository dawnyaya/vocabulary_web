# API Configuration (Optional - for future use)

# Translation API (e.g., LibreTranslate, Google Translate)
# VITE_TRANSLATION_API_URL=https://libretranslate.com/translate
# VITE_TRANSLATION_API_KEY=your_api_key_here

# AI API (e.g., OpenAI, Anthropic Claude)
# VITE_AI_API_URL=https://api.openai.com/v1/chat/completions
# VITE_AI_API_KEY=your_api_key_here

# Feature Flags
# VITE_ENABLE_ANALYTICS=false
